# Скопируйте в .env и задайте свой пароль: только латинские буквы и цифры
POSTGRES_PASSWORD=changeme
# Порт приложения на вашем компьютере; если 8000 занят — поставьте, например, 8001
APP_PORT=8000
# Таймаут подключения к базе, секунд (необязательно, по умолчанию 3).
# Действует при запуске без Docker. В контейнере не задаётся: действует умолчание из settings.py
# DB_CONNECT_TIMEOUT=3
